# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Supabase dashboard -> Project Settings -> API keys.
#
# Supabase is mid-migration on key naming. The modern keys are `sb_publishable_...`
# and `sb_secret_...`; the legacy `anon` / `service_role` JWTs still work but are
# deprecated end of 2026. Use the modern ones if your project offers them - the
# variable names below are ours, so paste whichever key type you have.

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key. Low privilege, subject to Row Level Security.
# Modern: sb_publishable_...   Legacy: the `anon` JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ and never import it into a
# client component - that would ship it to the browser and hand every player
# write access to every save.
#
# Modern: sb_secret_...   Legacy: the `service_role` JWT.
#
# This key bypasses Row Level Security, which is deliberate and load-bearing:
# the RLS policy in supabase/schema.sql grants players SELECT on their own save
# and nothing else. No INSERT, no UPDATE, no DELETE. Writes exist only inside
# the /api/command route handler, which validates through applyCommand first.
#
# Without that split, a player could open devtools and UPDATE their own gold
# directly through supabase-js, and the entire command layer would be theatre.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Origin used to build OAuth redirect URLs when an anonymous account links to a
# real one. http://localhost:3000 locally; your deployment URL in production.
# Wrong value here is the usual cause of "redirect_uri mismatch" on first login.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
