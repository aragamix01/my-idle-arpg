# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev save store (file persistence adapter)
/.data

# playwright
/test-results
/playwright-report
/blob-report
/.playwright

# generated by pnpm atlas
/public/atlas

# Source art must carry an alpha channel; JPEG cannot. A .jpg here is always
# a screenshot that wandered in, never a usable sheet.
assets/source/*.jpg
assets/source/*.jpeg
# Original pack downloads - the extracted files are what the build reads.
assets/source/*.zip
